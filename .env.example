# PostgreSQL connection used by the server-side auth and student management APIs
DATABASE_URL=postgresql://postgres:password@localhost:5432/campusos
# Use a random value with at least 32 characters in every environment
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Used by npm run db:seed-admin
ADMIN_EMAIL=premkishorereddy0@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=CampusOS Administrator

# Optional: server-side RAG provider
GROQ_API_KEY=
# Server-side Resend email delivery (optional)
RESEND_API_KEY=
MAIL_FROM=CampusOS <notifications@example.com>

COMPLAINT_ADMIN_EMAIL=premkishorereddy0@gmail.com
